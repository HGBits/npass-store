# Maintainer: Henrique <TROQUE_PELO_SEU_EMAIL_OU_HANDLE>
#
# Pacote -git: não existe release/tag ainda neste repositório, então
# pkgver() segue HEAD via git describe (com fallback para
# rcontagem.hash quando não há tag nenhuma, que é o caso hoje).
# Quando um dia existir uma tag de versão, isso passa a funcionar sem
# nenhuma mudança neste arquivo.
#
# NÃO TESTADO com makepkg/namcap de verdade - este ambiente de build
# não tem ferramentas Arch disponíveis. Rode `makepkg -si` e
# `namcap PKGBUILD` (e `namcap npass-git-*.pkg.tar.zst` depois de
# empacotar) antes de publicar. Dois campos abaixo são placeholder
# de propósito e PRECISAM ser preenchidos por você:
#   - url=: o endereço público do seu Forgejo/repositório
#   - license=: este projeto não tem nenhum arquivo LICENSE ainda -
#     escolha uma (GPL-3.0-or-later seria a mais próxima do pass/
#     pass-otp originais que foram usados como base de partida, mas a
#     decisão é sua) e crie o arquivo LICENSE no repo antes de publicar.

pkgname=npass-git
pkgver=r0.0
pkgrel=1
pkgdesc="Wayland-native password store com resolução de identidade (fork reescrito do pass)"
arch=('any')
url="https://github.com/HGBits/npass-store.git"
license=('gplv3')
# glow: o renderizador do 'npass show' em terminal (markdown, links). Sem ele o show ainda
# funciona (avisa e imprime o texto cru), mas a proposta do md1 depende dele, entao e dependencia.
depends=('bash' 'gnupg' 'glow')
optdepends=(
	'git: para "npass git" e commits automáticos por identidade'
	'python: para a extensão opcional npass-import (instale com ./install.sh --extensions-only)'
	'wl-clipboard: para "npass clip" e "npass otp clip" (Wayland; para X11 use a extensão opcional npass-clip-x11)'
	'xclip: para a extensão opcional npass-clip-x11 (clipboard em sessões X11)'
	'oathtool: para "npass otp" (ou otptool)'
	'otptool: alternativa ao oathtool para "npass otp"'
	'qrencode: para "npass otp uri -q" (QR code no terminal)'
)
makedepends=('git')
provides=('npass')
conflicts=('npass')
source=("$pkgname::git+$url")
sha256sums=('SKIP')

pkgver() {
	cd "$pkgname" || exit 1
	local ver
	if ver="$(git describe --long --tags 2>/dev/null)"; then
		printf '%s' "$ver" | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
	else
		printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
	fi
}

build() {
	cd "$pkgname" || exit 1
	bash release.sh --build-only
}

package() {
	cd "$pkgname" || exit 1

	install -Dm755 bin/npass "$pkgdir/usr/bin/npass"
	install -Dm644 man/npass.1 "$pkgdir/usr/share/man/man1/npass.1"
	install -Dm644 encrypts_alternatives/wordlist.txt "$pkgdir/usr/share/npass/encrypts_alternatives/wordlist.txt"
	install -Dm644 packaging/npass-release.asc "$pkgdir/usr/share/npass/extension-signing-key.asc"
	sed 's#@NPASS@#/usr/bin/npass#' packaging/npass-open.desktop.in > "$srcdir/npass-open.desktop"
	install -Dm644 "$srcdir/npass-open.desktop" "$pkgdir/usr/share/applications/npass-open.desktop"
}
