def list_formats():
    for name, (_, pt, en) in FORMATS.items():
        print("%-14s %s" % (name, en if _EN else pt))


def main(argv):
    ap = argparse.ArgumentParser(prog="npass import", add_help=False, allow_abbrev=False)
    ap.add_argument("args", nargs="*")
    ap.add_argument("-p", "--path", default="")
    ap.add_argument("-f", "--force", action="store_true")
    ap.add_argument("-d", "--dry-run", action="store_true")
    ap.add_argument("-v", "--verbose", action="store_true")
    ap.add_argument("--delete-source", action="store_true")
    ap.add_argument("--cols", default="")
    ap.add_argument("--del", dest="delimiter", default=",")
    ap.add_argument("--skip-header", action="store_true")
    ap.add_argument("--encoding", default="utf-8")
    ap.add_argument("-l", "--list", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("-V", "--version", action="store_true")
    try:
        o = ap.parse_intermixed_args(argv)
    except SystemExit:
        die(t("uso"), 2)
    if o.version:
        print("npass-import " + VERSION)
        return 0
    if o.list:
        list_formats()
        return 0
    if o.help or not o.args:
        print(__doc__.strip().split("\n\n")[0])
        print(t("uso"))
        return 0 if o.help else 2
    if len(o.args) < 3:
        die(t("faltam_args"), 2)
    fmt, ident, files = o.args[0].lower(), o.args[1], o.args[2:]
    if fmt not in FORMATS:
        die(t("fmt_desc", fmt), 2)

    binp = npass_bin()

    if fmt in TREES:
        return import_tree(fmt, o, binp, ident, files)

    parser = FORMATS[fmt][0]
    entries = []
    for f in files:
        entries.extend(parser(read_source(f, o), o))

    prefix = comp_group(o.path)
    paths = assign_paths(entries, prefix)
    have = existing_paths(binp, ident)

    items, skipped, ignored, errors = [], 0, 0, 0
    for e, p in zip(entries, paths):
        if not (e.password or e.otp or e.notes.strip() or e.extra):
            warn(t("vazia", p))
            ignored += 1
            continue
        body = render(e)
        if body is None:
            warn(t("senha_nl", p))
            errors += 1
            continue
        if p in have and not o.force:
            if o.verbose or o.dry_run:
                print("= " + t("existe", p))
            skipped += 1
            continue
        items.append((p, body))
        if o.verbose or o.dry_run:
            print(("! " if p in have else "+ ") + p)

    print(t("resumo", len(entries), fmt, len(items), skipped, ignored, errors), file=sys.stderr)
    if o.dry_run:
        print(t("dry"), file=sys.stderr)
        return 1 if errors else 0
    rc = write_batch(binp, ident, items, o.force) if items else 0
    if rc != 0:
        warn(t("core_falhou", rc))
        return rc
    if o.delete_source and not errors:
        for f in files:
            delete_source(f)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
