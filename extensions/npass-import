def imp_profile(name):
    prof = PROFILES[name]
    return lambda text, o: entries_from_csv(text, prof, o.delimiter)


def imp_csv(text, o):
    if not o.cols:
        die(t("cols"))
    names = [c.strip().lower() for c in o.cols.split(",")]
    known = {"title", "group", "login", "password", "url", "email", "notes", "otp"}
    if not any(names):
        die(t("col_vazia"))
    out = []
    rows = list(csv.reader(io.StringIO(text.lstrip("\ufeff"), newline=""), delimiter=o.delimiter))
    if o.skip_header and rows:
        rows = rows[1:]
    for row in rows:
        if not any(c.strip() for c in row):
            continue
        e = Entry()
        for i, name in enumerate(names):
            if not name or i >= len(row) or row[i] == "":
                continue
            v = row[i]
            if name == "otp":
                add_otp(e, v)
            elif name in known:
                setattr(e, name, v)
            else:
                e.extra.append((one_line(name), one_line(v)))
        out.append(e)
    return out


def _flatten(prefix, obj, out):
    if isinstance(obj, dict):
        for k, v in obj.items():
            _flatten("%s-%s" % (prefix, k) if prefix else k, v, out)
    elif obj not in (None, "", []):
        out.append((prefix, one_line(obj)))


def imp_bitwarden(text, o):
    if not text.lstrip().startswith("{"):
        return entries_from_csv(text, PROFILES["bitwarden-csv"], o.delimiter)
    try:
        doc = json.loads(text)
    except ValueError as ex:
        die(t("parse", "bitwarden", ex))
    if doc.get("encrypted"):
        die(t("cifrado"))
    folders = {f.get("id"): s(f.get("name")) for f in doc.get("folders", [])}
    out = []
    for it in doc.get("items", []):
        e = Entry(title=s(it.get("name")), group=folders.get(it.get("folderId"), ""), notes=s(it.get("notes")))
        login = it.get("login") or {}
        e.login, e.password = s(login.get("username")), s(login.get("password"))
        uris = [s(u.get("uri")) for u in login.get("uris") or [] if u.get("uri")]
        e.url = uris[0] if uris else ""
        for i, u in enumerate(uris[1:], start=2):
            e.extra.append(("url-%d" % i, u))
        add_otp(e, login.get("totp"))
        for f in it.get("fields") or []:
            if f.get("name") and f.get("value") not in (None, ""):
                e.extra.append((one_line(f["name"]), one_line(f["value"])))
        for kind in ("card", "identity"):
            if it.get(kind):
                flat = []
                _flatten(kind, it[kind], flat)
                e.extra.extend(flat)
        out.append(e)
    return out


def imp_aegis(text, o):
    try:
        doc = json.loads(text)
    except ValueError as ex:
        die(t("parse", "aegis", ex))
    db = doc.get("db")
    if not isinstance(db, dict):
        die(t("cifrado"))
    out = []
    for it in db.get("entries", []):
        info = it.get("info") or {}
        e = Entry(title=s(it.get("issuer")) or s(it.get("name")), login=s(it.get("name")), notes=s(it.get("note")))
        if s(it.get("type")).lower() in ("totp", "hotp") and info.get("secret"):
            e.otp.append(build_otpauth(it["type"], info["secret"], it.get("name"), it.get("issuer"),
                                       info.get("algo"), info.get("digits"), info.get("period"), info.get("counter")))
        elif info.get("secret"):
            e.extra.append(("otp-" + s(it.get("type")).lower(), s(info["secret"])))
        out.append(e)
    return out


def imp_andotp(text, o):
    if text.lstrip()[:1] != "[":
        die(t("cifrado"))
    try:
        items = json.loads(text)
    except ValueError as ex:
        die(t("parse", "andotp", ex))
    out = []
    for it in items:
        label, issuer = s(it.get("label")), s(it.get("issuer"))
        if ":" in label and not issuer:
            issuer, label = label.split(":", 1)
        elif label.startswith(issuer + ":") and issuer:
            label = label[len(issuer) + 1:]
        e = Entry(title=issuer or label, login=label.strip())
        kind = s(it.get("type")).lower()
        if kind in ("totp", "hotp") and it.get("secret"):
            e.otp.append(build_otpauth(kind, it["secret"], label.strip(), issuer,
                                       it.get("algorithm"), it.get("digits"), it.get("period"), it.get("counter")))
        elif it.get("secret"):
            e.extra.append(("otp-" + (kind or "desconhecido"), s(it["secret"])))
        out.append(e)
    return out


