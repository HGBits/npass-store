def npass_bin():
    b = os.environ.get("NPASS_BIN", "")
    if not (b and os.access(b, os.X_OK)):
        die(t("sem_bin"))
    return b


def read_source(path, o):
    if path == "-":
        data = sys.stdin.buffer.read()
    else:
        if not os.path.isfile(path):
            die(t("sem_arquivo", path))
        with open(path, "rb") as fh:
            data = fh.read()
    if path.endswith((".gpg", ".pgp", ".asc")) or data.startswith(b"-----BEGIN PGP MESSAGE-----"):
        gpg = os.environ.get("NPASS_GPG", "gpg")
        r = subprocess.run([gpg, "--quiet", "--batch", "--use-agent", "--decrypt"],
                           input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r.returncode != 0:
            die(t("gpg_falhou", path, r.stderr.decode(errors="replace").strip()))
        data = r.stdout
    try:
        return data.decode(o.encoding)
    except (UnicodeDecodeError, LookupError):
        die(t("decode", path, o.encoding))


def existing_paths(binp, ident):
    r = subprocess.run([binp, "ls", ident], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        die(t("id_ls", ident, (r.stderr or r.stdout).strip()))
    return {ln[2:] for ln in r.stdout.splitlines()[1:] if ln.startswith("  ")}


def write_batch(binp, ident, items, force):
    enc = lambda v: v.encode("utf-8", "surrogateescape")
    payload = b"".join(enc(p) + b"\0" + enc(c) + b"\0" for p, c in items)
    cmd = [binp, "insert", "--batch"] + (["-f"] if force else []) + [ident]
    return subprocess.run(cmd, input=payload).returncode


def delete_source(path, quiet=False):
    if path == "-":
        return
    if path.endswith((".gpg", ".pgp", ".asc")):
        os.remove(path)  # ja esta cifrado: basta remover
    else:
        fs = subprocess.run(["stat", "-f", "-c", "%T", path], stdout=subprocess.PIPE, text=True).stdout.strip()
        if fs == "btrfs":
            warn(t("shred_btrfs", path))
        if subprocess.run(["shred", "-u", path]).returncode != 0 and os.path.exists(path):
            os.remove(path)
    if not quiet:
        print(t("apagado", path), file=sys.stderr)


