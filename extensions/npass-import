def gpg_decrypt_file(path):
    """Decifra em memoria. Devolve o texto SEM as quebras de linha finais (como um
    $(...) do shell, que e o que o antigo migrate fazia) ou None se falhar."""
    gpg = os.environ.get("NPASS_GPG", "gpg")
    r = subprocess.run([gpg, "--quiet", "--batch", "--use-agent", "-d", "-o", "-", path],
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r.returncode != 0:
        return None
    return r.stdout.decode("utf-8", "surrogateescape").replace("\0", "").rstrip("\n")


def parse_codename_map(body):
    """'CODIGO = valor' por linha. A regex e gulosa: um valor que contem ' = ' parte
    na ULTIMA ocorrencia (limitacao conhecida do formato, igual ao migrate-secrets)."""
    out = {}
    for line in body.splitlines():
        m = re.match(r"^(.+) = (.+)$", line)
        if m:
            out[m.group(1)] = m.group(2)
    return out


def find_gpg_files(root, skip=()):
    """Todo *.gpg regular (nao symlink) sob root, fora de .git, em ordem estavel."""
    out = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d != ".git"]
        for fn in filenames:
            p = os.path.join(dirpath, fn)
            if fn.endswith(".gpg") and p not in skip and os.path.isfile(p) and not os.path.islink(p):
                out.append(p)
    return sorted(out)


def valid_logical(p):
    """Espelha o npass_check_sneaky_path do core, para que UM nome estranho vindo do
    disco seja pulado e relatado em vez de abortar o lote inteiro."""
    return not (p in ("", ".", "..") or p.startswith("/") or p.startswith("../")
                or p.endswith("/..") or "/../" in p or "\t" in p or "\n" in p)


def import_tree(fmt, o, binp, ident, args):
    if len(args) != 1:
        die(t("um_dir", fmt), 2)
    root = args[0]
    if not os.path.isdir(root):
        die(t("dir_nao_encontrado", root))
    root = root.rstrip("/") or "/"

    # Identidade: se nao existe, nasce do .gpg-id da origem (e ja assinada se a origem
    # tinha .gpg-id.sig). Uma identidade que JA existia nunca e assinada aqui como
    # efeito colateral: isso continua sendo uma decisao explicita (`npass sign`).
    gid = os.path.join(root, ".gpg-id")
    exists = os.path.isfile(os.path.join(os.environ.get("NPASS_STORE", ""), ident, ".gpg-id"))
    created = False
    if not exists:
        if not os.path.isfile(gid):
            die(t("id_sem_auto_criar", ident, root))
        if not o.dry_run:
            with open(gid, encoding="utf-8", errors="replace") as fh:
                recips = [ln.strip() for ln in fh.read().splitlines() if ln.strip()]
            cmd = [binp, "init"] + (["--sign"] if os.path.isfile(gid + ".sig") else []) + [ident] + recips
            if subprocess.run(cmd).returncode != 0:
                die(t("init_falhou", ident))
            created = True

    skip = {os.path.join(root, n) for n in (".secrets.gpg", ".mask.gpg")} if fmt == "pass-secrets" else set()
    files = find_gpg_files(root, skip)
    if not files:
        print(t("nenhum_gpg", root))
        return 0

    secrets, mask = {}, {}
    if fmt == "pass-secrets" and not o.dry_run:
        for name, store_, key in ((".secrets.gpg", secrets, "secrets_sem"), (".mask.gpg", mask, "mask_sem")):
            fp = os.path.join(root, name)
            if os.path.isfile(fp):
                body = gpg_decrypt_file(fp)
                if body is None:
                    warn(t(key))
                else:
                    store_.update(parse_codename_map(body))

    have = set() if (created or not exists) else existing_paths(binp, ident)
    prefix = comp_group(o.path)
    items, sources, skipped, failed = [], [], 0, 0
    for f in files:
        logical = os.path.relpath(f, root)[:-len(".gpg")]
        path = "/".join(x for x in (prefix, logical) if x)
        if not valid_logical(path):
            warn(t("caminho_invalido", logical))
            failed += 1
            continue
        if path in have and not o.force:
            warn(t("ja_existe", logical, ident))
            skipped += 1
            continue
        if o.dry_run:
            print(("! " if path in have else "+ ") + path)
            items.append((path, ""))
            continue
        body = gpg_decrypt_file(f)
        if body is None:
            warn(t("falha_decifrar", logical))
            failed += 1
            continue
        if fmt == "pass-secrets":
            real = secrets.get(logical, "")
            alias = mask.get(logical.split("/")[0], "")
            if real:
                body += "\n# %s: %s" % (LABEL_REAL, real)
            if alias:
                body += "\n# %s: %s" % (LABEL_ALIAS, alias)
        if o.verbose:
            print(("! " if path in have else "+ ") + path)
        items.append((path, body))
        sources.append(f)

    if o.dry_run:
        print(t("resumo_tree", ident, len(items), skipped, failed))
        print(t("dry"), file=sys.stderr)
        return 1 if failed else 0

    if items:
        rc = write_batch(binp, ident, items, o.force)
        if rc != 0:
            warn(t("core_falhou", rc))
            return rc
        if o.delete_source:
            for f in sources:
                delete_source(f, quiet=True)
    print(t("resumo_tree", ident, len(items), skipped, failed))
    return 1 if failed else 0


