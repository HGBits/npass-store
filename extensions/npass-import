# --------------------------------------------------------------------------
# caminhos logicos
# --------------------------------------------------------------------------
_CTRL = re.compile(r"[\x00-\x1f\x7f]")


def comp(v):
    """Um componente de caminho: sem controle, sem '/', nunca '.' ou '..'."""
    v = re.sub(r"\s+", " ", _CTRL.sub(" ", s(v)).replace("/", "-")).strip()
    return "" if set(v) <= {"."} else v


def comp_group(g):
    parts = [comp(p) for p in re.split(r"[\\/]+", s(g))]
    return "/".join(p for p in parts if p)


def base_path(e, prefix):
    title = comp(e.title) or comp(hostname(e.url)) or comp(e.login) or comp(e.email) \
        or ("untitled" if _EN else "sem-titulo")
    return "/".join(p for p in (prefix, comp_group(e.group), title) if p)


def assign_paths(entries, prefix):
    counts = {}
    for e in entries:
        b = base_path(e, prefix)
        counts[b] = counts.get(b, 0) + 1
    used, out = set(), []
    for i, e in enumerate(entries, start=1):
        b = base_path(e, prefix)
        p0 = b if counts[b] == 1 else "%s/%s" % (b, comp(e.login) or comp(e.email) or str(i))
        p, n = p0, 1
        while p in used:
            n += 1
            p = "%s-%d" % (p0, n)
        used.add(p)
        out.append(p)
    return out


def render(e):
    if "\n" in e.password or "\r" in e.password:
        return None
    lines = [e.password]
    if e.login:
        lines.append("login: " + one_line(e.login))
    if e.email and e.email != e.login:
        lines.append("email: " + one_line(e.email))
    if e.url:
        lines.append("url: " + one_line(e.url))
    for k, v in e.extra:
        k = re.sub(r"[:\r\n\t]+", " ", s(k)).strip()
        if k and one_line(v):
            lines.append("%s: %s" % (k, one_line(v)))
    lines.extend(e.otp)
    if e.notes.strip():
        lines.extend(["", e.notes.replace("\r\n", "\n").replace("\r", "\n").strip("\n")])
    return "\n".join(lines).replace("\0", "")


