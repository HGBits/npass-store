def t(key, *a):
    s = _M[key][1 if _EN else 0]
    return s % a if a else s


def die(msg, code=1):
    print("npass import: " + msg, file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print("npass import: " + msg, file=sys.stderr)


# --------------------------------------------------------------------------
# modelo de dados
# --------------------------------------------------------------------------
@dataclass
class Entry:
    title: str = ""
    group: str = ""
    login: str = ""
    password: str = ""
    url: str = ""
    email: str = ""
    notes: str = ""
    otp: list = field(default_factory=list)      # linhas otpauth://
    extra: list = field(default_factory=list)    # pares (chave, valor) de uma linha


def s(v):
    return "" if v is None else str(v)


def one_line(v):
    return re.sub(r"[\r\n\t]+", " ", s(v)).strip()


def hostname(url):
    u = s(url).strip()
    if not u:
        return ""
    try:
        h = urllib.parse.urlparse(u if "://" in u else "//" + u).hostname or ""
    except ValueError:
        return ""
    return h[4:] if h.startswith("www.") else h


# --------------------------------------------------------------------------
# OTP
# --------------------------------------------------------------------------
_B32 = re.compile(r"^[A-Za-z2-7= ]{8,}$")


def build_otpauth(kind, secret, label="", issuer="", algo="SHA1", digits=6, period=30, counter=None):
    kind = "hotp" if s(kind).lower() == "hotp" else "totp"
    secret = re.sub(r"[\s=]+$", "", s(secret).replace(" ", "")).upper()
    q = lambda v: urllib.parse.quote(s(v), safe="")
    if issuer and label:
        lab = q(issuer) + ":" + q(label)
    else:
        lab = q(issuer or label or "otp")
    params = [("secret", secret)]
    if issuer:
        params.append(("issuer", issuer))
    algo = s(algo or "SHA1").upper().replace("-", "")
    if algo != "SHA1":
        params.append(("algorithm", algo))
    if int(digits or 6) != 6:
        params.append(("digits", int(digits)))
    if kind == "hotp":
        params.append(("counter", int(counter or 0)))
    elif int(period or 30) != 30:
        params.append(("period", int(period)))
    return "otpauth://%s/%s?%s" % (kind, lab, "&".join("%s=%s" % (k, q(v)) for k, v in params))


def normalize_otp(value, label="", issuer=""):
    """Devolve (uri | None, bruto | None). Aceita URI, segredo base32 puro e o
    formato 'key=...&step=...' do KeeOtp. O que nao reconhece vai como campo bruto."""
    v = s(value).strip()
    if not v:
        return None, None
    if v.lower().startswith("otpauth://"):
        return v, None
    if v.startswith("key="):
        qs = urllib.parse.parse_qs(v)
        key = (qs.get("key") or [""])[0]
        if key:
            return build_otpauth("totp", key, label, issuer,
                                 digits=int((qs.get("size") or [6])[0]),
                                 period=int((qs.get("step") or [30])[0])), None
    if _B32.match(v):
        return build_otpauth("totp", v, label, issuer), None
    return None, v


def add_otp(e, value):
    uri, raw = normalize_otp(value, e.login or e.email, e.title)
    if uri:
        e.otp.append(uri)
    elif raw:
        e.extra.append(("otp-bruto" if not _EN else "otp-raw", one_line(raw)))


# --------------------------------------------------------------------------
# leitura de CSV guiada por perfil (nomes de coluna, sem diferenciar caixa)
# --------------------------------------------------------------------------
def read_csv(text, delimiter=","):
    reader = csv.DictReader(io.StringIO(text.lstrip("\ufeff"), newline=""), delimiter=delimiter)
    rows = []
    for row in reader:
        rows.append({(k or "").strip().lower(): (v if v is not None else "")
                     for k, v in row.items() if k is not None})
    return rows


def pick(row, names):
    for n in names:
        v = row.get(n, "")
        if isinstance(v, str) and v.strip() != "":
            return v
    return ""


def entries_from_csv(text, prof, delimiter=","):
    out = []
    for r in read_csv(text, delimiter):
        e = Entry(
            title=pick(r, prof.get("title", [])),
            group=pick(r, prof.get("group", [])),
            login=pick(r, prof.get("login", [])),
            password=pick(r, prof.get("password", [])),
            url=pick(r, prof.get("url", [])),
            email=pick(r, prof.get("email", [])),
            notes=pick(r, prof.get("notes", [])),
        )
        add_otp(e, pick(r, prof.get("otp", [])))
        hook = prof.get("hook")
        if hook:
            hook(r, e)
        out.append(e)
    return out


def _lastpass_hook(r, e):
    if e.url == "http://sn":  # nota segura do LastPass
        e.url = ""


def _bitwarden_csv_hook(r, e):
    uris = [u.strip() for u in s(r.get("login_uri", "")).splitlines() if u.strip()]
    e.url = uris[0] if uris else ""
    for i, u in enumerate(uris[1:], start=2):
        e.extra.append(("url-%d" % i, u))
    rest = []
    for line in s(r.get("fields", "")).splitlines():
        if ": " in line:
            k, v = line.split(": ", 1)
            e.extra.append((one_line(k), one_line(v)))
        elif line.strip():
            rest.append(line)
    if rest:
        e.notes = (e.notes + "\n" if e.notes else "") + "\n".join(rest)


